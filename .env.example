BOT_TOKEN=
DB_PATH=data/bot_go.db
BOT_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
REPLAY_WINDOW_SECONDS=60
LARGE_TXN_THRESHOLD=50000
ADMIN_ADDR=:8090
ADMIN_TOKEN=
# 单管理员后台登录；完整配置后启用 /admin 登录页。
ADMIN_USERNAME=
# bcrypt 哈希含有 `$`，写入实际 .env 时请使用单引号，例如：ADMIN_PASSWORD_HASH='$2a$...'
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# 一次性首次扫码绑定口令；仅通过运维安全渠道配置，完成 setup 后仍建议保留用于审计轮换策略。
ADMIN_SETUP_TOKEN=

# Telegram Long Polling 的真实输入健康状态。空响应也视为一次成功轮询。
POLL_STATUS_PATH=data/recovery/poll-status.json
POLL_STARTUP_GRACE=90s
POLL_MAX_SUCCESS_AGE=90s
POLL_MIN_FAILURE_COUNT=3
# 由不可变 release 的 release.env 覆盖；不要手工填写未验证的版本或哈希。
RELEASE_ID=
RELEASE_SHA256=

# 独立 Guardian 仅在显式安装并启用其 systemd timer 后使用。
# 它只执行固定 restart / 已验证 last-known-good 试回滚，不读取 BOT_TOKEN。
LEDGERBOT_RELEASE_ROOT=/opt/bilibili-ledgerbot-20260704
LEDGERBOT_SERVICE_NAME=bilibili-ledgerbot.service
GUARDIAN_COOLDOWN=15m
GUARDIAN_VERIFY_TIMEOUT=90s
# 灰度阶段保持 restart-only；完成回滚演练后才允许自动试回滚。
GUARDIAN_AUTO_ROLLBACK_ENABLED=false

# 旧版脚本式自动修复暂时关闭；脚本补齐并单独验收后再开启。
AUTO_REMEDIATION_ENABLED=false

SUPPORT_CHAT_ID=6253397539
SUPPORT_URL=
PRIVATE_TRIAL_DAYS=3

# 联调用（非程序必填）
TEST_CHAT_ID=-1003829659428
TEST_USER_ID=6253397539

TG_WEBAPP_URL=
TG_WEBAPP_SECRET=

# 地址验证动态图片；默认 multipart，local_url 仅在同域 Nginx 路由和目录权限就绪后显式启用。
ADDRESS_VERIFY_MEDIA_MODE=multipart
# 生产固定目录：/var/lib/ledgerbot/telegram-media
ADDRESS_VERIFY_MEDIA_DIR=
# 生产精确地址：https://autobookbl.site/tg/media
ADDRESS_VERIFY_MEDIA_PUBLIC_BASE_URL=
ADDRESS_VERIFY_MEDIA_TTL=1h

BANK_BRANCH_API_URL=
BANK_BRANCH_API_TOKEN=
BANK_BRANCH_API_HEADER=Authorization
BANK_BRANCH_API_TIMEOUT_SEC=8

# 距离/汇率/查卡能力迁移配置
GEO_GEOCODE_ENDPOINT=https://nominatim.openstreetmap.org/search
GEO_ROUTE_ENDPOINT=https://router.project-osrm.org/route/v1/driving
GEO_TIMEOUT_MS=3000
GEO_RETRY_MAX=1
GEO_BACKOFF_MS=200
GEO_CACHE_TTL_SEC=1800

EXCHANGE_TIMEOUT_MS=3000
EXCHANGE_RETRY_MAX=1
EXCHANGE_BACKOFF_MS=200
EXCHANGE_MIN_SAMPLE=3

CARD_TIMEOUT_MS=3000
CARD_RETRY_MAX=1
CARD_BACKOFF_MS=200
